# 阿里云 OSS（上传图片）
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your-bucket-name

# 千问 OCR (DashScope)
DASHSCOPE_API_KEY=your_dashscope_api_key

# DeepSeek 翻译
DEEPSEEK_API_KEY=your_deepseek_api_key

# PaddleOCR AI Studio 异步接口（bearer token；transAgent 加 --figures 插图提取也会用）
PADDLE_OCR_TOKEN=your_token
# 插图裁剪（transAgent，可选）
# FIGURE_EXTRACT_DPI=300
# PADDLE_LAYOUT_MODEL=PaddleOCR-VL-1.5
# PADDLE_LAYOUT_USE_CHART=true
# FIGURE_CROP_PADDING=12
# FIGURE_CAPTION_GAP_PADDLE=18

# 可选：PDF 渲染分辨率，默认 200
# PDF_DPI=200
